generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProgramStatus {
  PENDING
  APPROVED
  DECLINED
  BACKUP
  WITHDRAWN
}

enum DeckStatus {
  SUBMITTED
  REVIEWED
  APPROVED
  CONCERN
}

enum ReviewerRole {
  ADMIN
  BOARD
  CHAIR
}

enum ConferenceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Conference {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  status    ConferenceStatus @default(ACTIVE)
  archivedAt DateTime? @map("archived_at")
  timezone  String   @default("America/Chicago")
  submissionsOpen Boolean @default(true) @map("submissions_open")
  submissionsOpenAt DateTime? @map("submissions_open_at")
  submissionsCloseAt DateTime? @map("submissions_close_at")
  rooms     Int      @default(8)
  sessionsPerRoom Int @default(8) @map("sessions_per_room")
  eodTrim   Int      @default(6) @map("eod_trim")
  graemeSlots Int    @default(4) @map("graeme_slots")
  sponsorMin Int     @default(7) @map("sponsor_min")
  sponsorMax Int     @default(11) @map("sponsor_max")
  decksPublished Boolean @default(false) @map("decks_published")
  decksPublishedAt DateTime? @map("decks_published_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submissions    Submission[]
  reviewerAccess ReviewerAccess[]
  scheduleRooms  ScheduleRoom[]
  scheduleSlots  ScheduleSlot[]
  schedulePlacements SchedulePlacement[]
  themes         Theme[]
}

enum SlotType {
  REGISTRATION
  KICKOFF
  SESSION
  BREAK
  LUNCH
  NETWORKING
}

model Theme {
  id           String   @id @default(cuid())
  conferenceId String   @map("conference_id")
  slug         String
  name         String
  targetMin    Int      @default(0) @map("target_min")
  targetMax    Int      @default(0) @map("target_max")
  sortOrder    Int      @default(0) @map("sort_order")

  conference   Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  submissions  SubmissionTheme[]

  @@unique([conferenceId, slug])
}

model SubmissionTheme {
  submissionId String @map("submission_id")
  themeId      String @map("theme_id")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  theme      Theme      @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([submissionId, themeId])
}

model ScheduleRoom {
  id           String   @id @default(cuid())
  conferenceId String   @map("conference_id")
  name         String
  sortOrder    Int      @map("sort_order")

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  placements SchedulePlacement[]

  @@unique([conferenceId, sortOrder])
}

model ScheduleSlot {
  id           String   @id @default(cuid())
  conferenceId String   @map("conference_id")
  label        String
  slotType     SlotType @map("slot_type")
  sortOrder    Int      @map("sort_order")

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  placements SchedulePlacement[]

  @@unique([conferenceId, sortOrder])
}

model SchedulePlacement {
  id           String  @id @default(cuid())
  conferenceId String  @map("conference_id")
  slotId       String  @map("slot_id")
  roomId       String  @map("room_id")
  submissionId String? @unique @map("submission_id")

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  slot       ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  room       ScheduleRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@unique([slotId, roomId])
}

model Submission {
  id           String        @id @default(cuid())
  conferenceId String        @map("conference_id")
  presenterTokenHash String  @unique @map("presenter_token_hash")
  programStatus ProgramStatus @default(PENDING) @map("program_status")
  deckStatus    DeckStatus?   @map("deck_status")
  deckShareable Boolean       @default(true) @map("deck_shareable")
  vipRegistered Boolean       @default(false) @map("vip_registered")
  isSponsorSession Boolean    @default(false) @map("is_sponsor_session")
  isSoftSkill   Boolean       @default(false) @map("is_soft_skill")
  approvedAt    DateTime?     @map("approved_at")
  withdrawnAt   DateTime?     @map("withdrawn_at")

  firstName     String  @map("first_name")
  lastName      String  @map("last_name")
  degrees       String  // JSON array
  jobTitle      String  @map("job_title")
  organization  String
  title         String
  abstract      String
  technicalLevel Int    @map("technical_level")
  bio           String
  email         String
  zipCode       String  @map("zip_code")
  phone         String
  linkedinUrl   String  @map("linkedin_url")
  linkedinHasPhoto Boolean @map("linkedin_has_photo")

  hasCoPresenter Boolean @default(false) @map("has_co_presenter")
  coPresenterName String? @map("co_presenter_name")
  coPresenterEmail String? @map("co_presenter_email")
  coPresenterDegrees String? @map("co_presenter_degrees")
  coPresenterJobTitle String? @map("co_presenter_job_title")
  coPresenterOrganization String? @map("co_presenter_organization")
  coPresenterBio String? @map("co_presenter_bio")
  coPresenterLinkedinUrl String? @map("co_presenter_linkedin_url")
  coPresenterLinkedinHasPhoto Boolean? @map("co_presenter_linkedin_has_photo")

  travelRestriction String? @map("travel_restriction")
  travelReimbursementRequired Boolean @default(false) @map("travel_reimbursement_required")
  additionalInfo String? @map("additional_info")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  scores     Score[]
  deckFiles  DeckFile[]
  schedulePlacement SchedulePlacement?
  themes     SubmissionTheme[]
}

model ReviewerAccess {
  id           String       @id @default(cuid())
  conferenceId String       @map("conference_id")
  tokenHash    String       @unique @map("token_hash")
  role         ReviewerRole
  label        String?
  expiresAt    DateTime?    @map("expires_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  scores     Score[]
}

model Score {
  id               String   @id @default(cuid())
  submissionId     String   @map("submission_id")
  reviewerAccessId String   @map("reviewer_access_id")
  value            Float
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  submission     Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerAccess ReviewerAccess @relation(fields: [reviewerAccessId], references: [id], onDelete: Cascade)

  @@unique([submissionId, reviewerAccessId])
}

model DeckFile {
  id           String   @id @default(cuid())
  submissionId String   @map("submission_id")
  publicId     String   @unique @default(cuid()) @map("public_id")
  version      Int
  filename     String
  storagePath  String   @map("storage_path")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// --- MinneMUDAC judging demo (separate from conference planning) ---

enum MudacEventStatus {
  DRAFT
  REGISTRATION_OPEN
  JUDGING
  LOCKED
  ARCHIVED
}

enum MudacDivision {
  UNDERGRADUATE
  GRADUATE
  POST_GRADUATE
}

enum MudacJudgeType {
  ACADEMIC
  INDUSTRY_BUSINESS
  INDUSTRY_TECHNICAL
  GENERAL
}

enum MudacIdGenerationMode {
  SEQUENTIAL
  RANDOM
}

enum MudacPanelAggregateMode {
  SUM
  MEAN
}

model MudacEvent {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  name                 String
  status               MudacEventStatus      @default(DRAFT)
  registrationOpen     Boolean               @default(false) @map("registration_open")
  registrationCodeHash String?               @map("registration_code_hash")
  judgesPerPanel       Int                   @default(3) @map("judges_per_panel")
  panelAggregateMode   MudacPanelAggregateMode @default(MEAN) @map("panel_aggregate_mode")
  idGenerationMode     MudacIdGenerationMode @default(SEQUENTIAL) @map("id_generation_mode")
  teamIdStart          Int                   @default(1) @map("team_id_start")
  teamIdEnd            Int                   @default(99) @map("team_id_end")
  teamIdIncrement      Int                   @default(1) @map("team_id_increment")
  teamIdPadWidth       Int                   @default(2) @map("team_id_pad_width")
  scoringLocked        Boolean               @default(false) @map("scoring_locked")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  criteria      MudacScoringCriterion[]
  teams         MudacTeam[]
  panels        MudacJudgePanel[]
  judges        MudacJudge[]
  directors     MudacDirectorAccess[]
  presentations MudacPresentation[]
}

model MudacScoringCriterion {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  sortOrder   Int      @map("sort_order")
  name        String
  description String?
  maxPoints   Int      @default(10) @map("max_points")
  weight      Float    @default(1.0)

  event  MudacEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scores MudacCriterionScore[]

  @@unique([eventId, sortOrder])
}

model MudacTeam {
  id        String       @id @default(cuid())
  eventId   String       @map("event_id")
  displayId String       @map("display_id")
  division  MudacDivision
  name      String?

  event         MudacEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  presentations MudacPresentation[]

  @@unique([eventId, displayId])
}

model MudacJudgePanel {
  id        String @id @default(cuid())
  eventId   String @map("event_id")
  label     String
  sortOrder Int    @map("sort_order")

  event           MudacEvent                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slotRequirements MudacPanelSlotRequirement[]
  assignments     MudacPanelAssignment[]
  presentations   MudacPresentation[]
}

model MudacPanelSlotRequirement {
  id        String         @id @default(cuid())
  panelId   String         @map("panel_id")
  slotIndex Int            @map("slot_index")
  judgeType MudacJudgeType @map("judge_type")

  panel MudacJudgePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, slotIndex])
}

model MudacJudge {
  id           String         @id @default(cuid())
  eventId      String         @map("event_id")
  name         String
  email        String
  affiliation  String?
  judgeType    MudacJudgeType @map("judge_type")
  tokenHash    String         @unique @map("token_hash")
  revokedAt    DateTime?      @map("revoked_at")
  registeredAt DateTime       @default(now()) @map("registered_at")

  event       MudacEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments MudacPanelAssignment[]
  scorecards  MudacJudgeScorecard[]

  @@unique([eventId, email])
}

model MudacPanelAssignment {
  id        String @id @default(cuid())
  panelId   String @map("panel_id")
  judgeId   String @map("judge_id")
  slotIndex Int    @map("slot_index")

  panel MudacJudgePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  judge MudacJudge      @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([panelId, slotIndex])
  @@unique([panelId, judgeId])
}

model MudacDirectorAccess {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  label     String
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")

  event MudacEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model MudacPresentation {
  id          String    @id @default(cuid())
  eventId     String    @map("event_id")
  panelId     String    @map("panel_id")
  teamId      String    @map("team_id")
  scheduledAt DateTime? @map("scheduled_at")

  event      MudacEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  panel      MudacJudgePanel     @relation(fields: [panelId], references: [id], onDelete: Cascade)
  team       MudacTeam           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  scorecards MudacJudgeScorecard[]

  @@unique([eventId, teamId])
}

model MudacJudgeScorecard {
  id             String    @id @default(cuid())
  presentationId String    @map("presentation_id")
  judgeId        String    @map("judge_id")
  submittedAt    DateTime? @map("submitted_at")
  notes          String?

  presentation MudacPresentation   @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  judge        MudacJudge          @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  scores       MudacCriterionScore[]

  @@unique([presentationId, judgeId])
}

model MudacCriterionScore {
  id          String @id @default(cuid())
  scorecardId String @map("scorecard_id")
  criterionId String @map("criterion_id")
  value       Float

  scorecard MudacJudgeScorecard   @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  criterion MudacScoringCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, criterionId])
}
