{
  "name": "minneanalytics-conference-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "docs:validate": "node scripts/validate-okf.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:baseline:resolve": "prisma migrate resolve --applied 20260904000000_baseline",
    "db:migration:verify": "node scripts/migrations/verify-foundation.mjs",
    "db:migration:report": "tsx scripts/migrations/report-baseline.ts",
    "db:004-b:backfill": "tsx scripts/migrations/backfill-004-b.ts",
    "db:004-b:vocabulary-backfill": "tsx scripts/migrations/backfill-004-b-vocabulary.ts",
    "db:004-b:verify": "tsx scripts/migrations/verify-004-b.ts",
    "db:004-b:vocabulary-verify": "tsx scripts/migrations/verify-004-b-vocabulary.ts",
    "db:backup": "node scripts/migrations/sqlite-backup.mjs",
    "db:restore:rehearse": "node scripts/migrations/sqlite-restore-rehearsal.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.28"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.17.57",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.4",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
