# --- Local laptop demo (default) ---
# Run: scripts/setup.ps1 then npm run dev
DEPLOYMENT_MODE=local
DATABASE_URL="file:./prisma/dev.db"
UPLOAD_DIR="./uploads"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

